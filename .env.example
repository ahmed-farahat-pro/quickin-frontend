# Base URL of the QuickIn backend API.
# Local dev default:
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# In production (Vercel), set this to the deployed backend URL, e.g.:
# NEXT_PUBLIC_API_URL=https://quickin-backend.vercel.app

# --- Payments (Paymob) -------------------------------------------------------
# Paymob lives ENTIRELY on quickin-backend (keys + webhook = single source of truth).
# The web "Pay now" flow proxies to NEXT_PUBLIC_API_URL above, forwarding the user's
# token, so this project needs NO Paymob keys. Two requirements for it to work:
#   1) NEXT_PUBLIC_API_URL must point at the deployed backend (not localhost) in prod.
#   2) AUTH_SECRET below MUST be identical to the backend's AUTH_SECRET, so the token
#      this app issues verifies on the backend. The two projects issue tokens
#      independently today, so they may currently DIFFER — set both to the same value.
# AUTH_SECRET=must-match-the-backend-exactly

# --- Admin panel: staff RBAC (/ops) ------------------------------------------
# The /ops console is gated by per-account staff sessions with per-module
# permissions (staff_accounts / staff_permissions / staff_sessions on Neon).
#
# Signs the qk_staff session cookie. Falls back to AUTH_SECRET, then to a dev
# default — SET THIS IN PRODUCTION. It is independent of AUTH_SECRET on purpose, so
# a staff token can never be interchanged with a guest qk_token; rotating it signs
# out all staff (and nothing else).
# STAFF_AUTH_SECRET=generate-a-long-random-value

# Idle auto-logout for staff, in minutes (default 30). The absolute session cap is
# 8h and is not configurable. Lower this to test auto-logout quickly.
# STAFF_IDLE_MINUTES=30

# Temporary cutover flag. When '1', a `users` row with role='admin' still satisfies
# an admin gate (granted all modules) so the two projects can deploy independently.
# Every use is written to staff_audit_log as 'legacy_fallback'. Set to '0' — or leave
# unset — once that count is zero, then delete the fallback from src/lib/local/staff.ts.
# STAFF_ALLOW_LEGACY_ADMIN=0

# Mail relay for staff password-reset codes (same pair the guest OTP flow uses).
# When either is unset the code is logged to the server console instead of emailed,
# and returned as `devCode`, so the reset flow still works offline.
# MAIL_BACKEND_URL=https://quickin-backend.vercel.app
# MAIL_RELAY_SECRET=must-match-the-backend-exactly

# REMOVED: ADMIN_OPS_KEY — the shared /ops admin secret. Replaced by staff accounts;
# delete it from the Vercel project.
